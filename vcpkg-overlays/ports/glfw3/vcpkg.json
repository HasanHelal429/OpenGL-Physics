{
  "name": "glfw3",
  "version": "3.5.1",
  "port-version": 100,
  "description": "GLFW built against the system X11 development libraries instead of vcpkg's own X11 ports.",
  "homepage": "https://github.com/glfw/glfw",
  "license": "Zlib",
  "supports": "!android",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "wayland": {
      "description": "Use Wayland display server",
      "supports": "linux",
      "dependencies": [
        "wayland"
      ]
    }
  }
}
